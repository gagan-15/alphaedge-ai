APP_ENV=development
DATABASE_URL=postgresql+psycopg://alphaedge:change-this-password@localhost:5432/alphaedge
DATABASE_ECHO=false
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MARKET_DATA_PROVIDER=yahoo
SHADOW_MARKET_DATA_PROVIDER=dhan
# When approved, set MARKET_DATA_PROVIDER=dhan. Dhan uses this isolated store.
DHAN_PRODUCTION_DATABASE_PATH=backend/data/scanner/alphaedge-dhan.sqlite3
# Keep Dhan credentials only in the untracked local .env file.
# DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Written locally after an official Dhan renewal/generation. Do not edit by hand.
DHAN_ACCESS_TOKEN_EXPIRES_AT=
